# ── Build outputs & backups (multi-GB, regenerated by Unity) ──
*.apk
*.aab
*.unitypackage
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# ── IDE / generated project files ───────────────────────
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# ── Logs / diagnostics created while building ──────────
*.log
android_build_report.txt
ar_plugin_config_report.txt
hgt_model_import_log.txt
unity_batch_log*.txt
unity_*_log.txt
unity_*compile*.txt
sysinfo.txt

# ── Unused Vuforia leftovers (132 MB package exceeds GitHub's 100 MB limit; proprietary) ──
Packages/*.tgz
Packages/*.bak
QCAR/

# ── Secrets / machine-specific (do NOT publish) ────────
# Vuforia license key lives in this config asset
Assets/Resources/VuforiaConfiguration.asset
Assets/Resources/VuforiaConfiguration.asset.meta
# Local MCP tooling config
.mcp.json
.env
*.keystore
*.jks

# ── OS files ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
